<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ContasApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContasLT"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Lê as notificações dos apps de banco (o usuário libera em Configurações › Acesso a notificações). -->
        <service
            android:name=".notify.BankNotificationListener"
            android:exported="true"
            android:label="ContasLT: lançamentos pelas notificações"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notify.InboxActionReceiver"
            android:exported="false" />

        <!-- Foto do comprovante tirada pela câmera (TransactionFormSheet). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Só os apps de banco conhecidos (nome, ícone e se estão instalados, na tela "Notificações dos bancos").
         Sem consulta ampla aos apps instalados. Mantenha igual a notify/BankApps.java. -->
    <queries>
        <package android:name="com.nu.production" />
        <package android:name="com.itau" />
        <package android:name="com.itau.pers" />
        <package android:name="br.com.intermedium" />
        <package android:name="com.c6bank.app" />
        <package android:name="com.bradesco" />
        <package android:name="br.com.bradesco.next" />
        <package android:name="com.santander.app" />
        <package android:name="br.com.bb.android" />
        <package android:name="br.com.gabba.Caixa" />
        <package android:name="com.picpay" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="br.com.uol.ps.myaccount" />
        <package android:name="br.com.neon" />
        <package android:name="com.btg.pactual.banking" />
        <package android:name="br.com.original.bank" />
        <package android:name="com.sicredi.app" />
        <package android:name="br.com.sicoobnet" />
    </queries>
</manifest>
