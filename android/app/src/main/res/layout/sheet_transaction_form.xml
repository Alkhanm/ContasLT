<?xml version="1.0" encoding="utf-8"?>
<!-- TransactionFormSheet.vue: despesa, receita ou transferência; comprovante; fatura de cartão; itens; escopo de
     recorrente. Cabeçalho fixo, formulário rolável e rodapé com o botão principal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sheet_transaction_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <TextView android:id="@+id/title" style="@style/Text.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="18sp" />
        <ImageView android:id="@+id/close" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Fechar" android:padding="7dp" android:src="@drawable/ic_x" app:tint="@color/muted_foreground" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <br.com.contaslt.ui.views.SegmentedControl android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- Perna de transferência vinculada -->
            <LinearLayout android:id="@+id/linkedNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_muted" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_arrow_left_right" app:tint="@color/muted_foreground" />
                <TextView android:id="@+id/linkedText" style="@style/Text.Muted.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" />
            </LinearLayout>

            <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Valor" />
            <br.com.contaslt.ui.views.MoneyInputView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/amountError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />

            <!-- Comprovante -->
            <LinearLayout android:id="@+id/receiptRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/scan" style="@style/Button.Outline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ler comprovante" app:icon="@drawable/ic_camera" app:iconSize="16dp" app:iconPadding="8dp" />
                <ImageView android:id="@+id/receiptThumb" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:background="@drawable/sheet_transaction_box" android:contentDescription="Abrir comprovante" android:padding="1dp" android:scaleType="centerCrop" android:visibility="gone" />
                <TextView android:id="@+id/receiptHint" style="@style/Text.Muted.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:id="@+id/waiting" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Lendo no seu computador… pode levar um minuto." android:visibility="gone" />

            <!-- Leitura adiada -->
            <LinearLayout android:id="@+id/deferred" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_muted_60" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_clock" app:tint="@color/muted_foreground" />
                <TextView style="@style/Text.Muted.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Foto guardada, leitura pendente. Salve o lançamento normalmente: os itens entram sozinhos quando o computador com o leitor estiver ligado, e você é avisado se o valor não bater." />
            </LinearLayout>

            <!-- ReceiptScanNotice.vue (lançamento em edição) -->
            <LinearLayout android:id="@+id/scanNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <ImageView android:id="@+id/scanNoticeIcon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/scanNoticeText" style="@style/Text.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/scanNoticeActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:paddingStart="20dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/scanNoticePrimary" style="@style/Button.Outline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="28dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/scanNoticeSecondary" style="@style/Button.Ghost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="28dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="@color/foreground" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Comprovante parece pagar um vencimento recorrente -->
            <LinearLayout android:id="@+id/recurringMatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_primary" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_repeat" app:tint="@color/primary" />
                    <TextView android:id="@+id/recurringMatchText" style="@style/Text.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" />
                </LinearLayout>
                <br.com.contaslt.ui.views.SegmentedControl android:id="@+id/recurringMatchToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Possível duplicata -->
            <LinearLayout android:id="@+id/duplicate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_warning" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_triangle_alert" app:tint="@color/warning" />
                <TextView android:id="@+id/duplicateText" style="@style/Text.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" />
            </LinearLayout>

            <!-- Transferência -->
            <LinearLayout android:id="@+id/transferSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="De" />
                        <br.com.contaslt.ui.views.AccountSelectView android:id="@+id/fromAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/fromAccountError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Para" />
                        <br.com.contaslt.ui.views.AccountSelectView android:id="@+id/toAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/toAccountError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data" />
                        <br.com.contaslt.ui.views.DateFieldView android:id="@+id/transferDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/transferDateError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descrição" />
                        <EditText android:id="@+id/transferDescription" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Transferência" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLength="140" android:maxLines="1" />
                        <TextView android:id="@+id/transferDescriptionError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/transferPaidRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_box" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
                    <TextView style="@style/Text.Semibold.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Já efetuada" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/transferPaid" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Sai de uma conta e entra na outra. Não conta como despesa nem como receita." />
            </LinearLayout>

            <!-- Despesa ou receita -->
            <LinearLayout android:id="@+id/normalSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Descrição" />
                <EditText android:id="@+id/description" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Ex.: Conta de luz" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLength="140" android:maxLines="1" />
                <TextView android:id="@+id/descriptionError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/dateLabel" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vencimento" />
                        <br.com.contaslt.ui.views.DateFieldView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/dateError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conta" />
                        <br.com.contaslt.ui.views.AccountSelectView android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/accountError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/onCardNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_muted" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:visibility="gone">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_credit_card" app:tint="@color/muted_foreground" />
                    <TextView style="@style/Text.Muted.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Compra no cartão: fica na fatura do período, fora da lista geral e dos totais. O que conta como despesa é a fatura paga." />
                </LinearLayout>

                <!-- Pagamento de fatura de cartão -->
                <LinearLayout android:id="@+id/invoiceBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_box" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:id="@+id/invoiceToggleRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="2dp" android:paddingEnd="12dp" android:paddingBottom="2dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_credit_card" app:tint="@color/muted_foreground" />
                        <TextView style="@style/Text.Semibold.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Pagamento de fatura de cartão" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/invoiceSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/invoiceBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cartão" />
                                <br.com.contaslt.ui.views.SelectFieldView android:id="@+id/invoiceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fatura" />
                                <br.com.contaslt.ui.views.SelectFieldView android:id="@+id/invoiceMonth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/invoicePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:visibility="gone">
                            <LinearLayout android:id="@+id/invoicePreviewHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:id="@+id/invoicePreviewTitle" style="@style/Text.Semibold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" />
                                <ImageView android:id="@+id/invoicePreviewChevron" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_down" app:tint="@color/muted_foreground" />
                            </LinearLayout>
                            <TextView android:id="@+id/invoicePreviewInfo" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                            <LinearLayout android:id="@+id/invoicePreviewList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/sheet_transaction_box" android:orientation="vertical" android:visibility="gone" />
                            <TextView android:id="@+id/invoicePreviewEmpty" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nenhuma compra registrada nesse período ainda. Comprovantes lidos depois entram aqui sozinhos." android:visibility="gone" />
                        </LinearLayout>
                        <Space android:layout_width="match_parent" android:layout_height="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/categoryField" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Categoria" />
                    <br.com.contaslt.ui.views.CategorySelectView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                    <TextView android:id="@+id/categoryError" style="@style/Text.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/destructive" android:visibility="gone" />
                </LinearLayout>

                <!-- Itens -->
                <LinearLayout android:id="@+id/itemsBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_box" android:orientation="vertical">
                    <LinearLayout android:id="@+id/itemsHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:minHeight="44dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:id="@+id/itemsTitle" style="@style/Text.Semibold.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <ImageView android:id="@+id/itemsChevron" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_down" app:tint="@color/muted_foreground" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/itemsBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />
                        <br.com.contaslt.ui.form.ReceiptItemsEditor android:id="@+id/items" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/paidRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_box" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
                    <TextView android:id="@+id/paidLabel" style="@style/Text.Semibold.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Já pago" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/paid" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Observações" />
                <EditText android:id="@+id/notes" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="top|start" android:hint="Opcional" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:minLines="2" />
            </LinearLayout>

            <!-- Ocorrência de conta recorrente: escopo -->
            <LinearLayout android:id="@+id/scopeBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/sheet_transaction_muted" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/ic_repeat" app:tint="@color/foreground" />
                    <TextView style="@style/Text.Semibold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Lançamento de conta recorrente. Aplicar alterações em:" android:textSize="12sp" />
                </LinearLayout>
                <br.com.contaslt.ui.views.SegmentedControl android:id="@+id/scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/scopeHint" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_transaction_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">
