<?xml version="1.0" encoding="utf-8"?>
<!-- TransferMatchSheet.vue: pares de saída e entrada de mesmo valor para vincular como transferência. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sheet_transaction_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Text.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cruzar transferências" android:textSize="18sp" />
            <TextView style="@style/Text.Muted.Sm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Saídas e entradas de mesmo valor em contas diferentes, com até 3 dias de diferença. Ao vincular, o par deixa de contar como despesa e receita." />
        </LinearLayout>
        <ImageView android:id="@+id/close" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Fechar" android:padding="7dp" android:src="@drawable/ic_x" app:tint="@color/muted_foreground" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/rejected" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/sheet_transaction_footer" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/linkAll" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" />
    </FrameLayout>
</LinearLayout>
