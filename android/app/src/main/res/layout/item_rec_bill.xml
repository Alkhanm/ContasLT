<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de conta recorrente: ícone, descrição e resumo, valor e o interruptor de ativa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout android:id="@+id/open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
        <br.com.contaslt.ui.views.CategoryIconView android:id="@+id/icon" android:layout_width="40dp" android:layout_height="40dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/description" style="@style/Text.Semibold" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" />
            <TextView android:id="@+id/meta" style="@style/Text.Muted.Xs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/amount" style="@style/Text.Semibold.Sm" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/active" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
</LinearLayout>
