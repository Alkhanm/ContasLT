<?xml version="1.0" encoding="utf-8"?>
<!-- Subcategoria dentro do cartão da categoria principal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/ic_corner_down_right" app:tint="@color/muted_foreground" />
    <LinearLayout android:id="@+id/open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
        <br.com.contaslt.ui.views.CategoryIconView android:id="@+id/icon" android:layout_width="28dp" android:layout_height="28dp" />
        <TextView android:id="@+id/name" style="@style/Text.Semibold.Sm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/archived" style="@style/Text.Muted.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="arquivada" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/actions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
</LinearLayout>
