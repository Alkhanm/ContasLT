<?xml version="1.0" encoding="utf-8"?>
<!-- Par sugerido: saída (conta em vermelho) ↓ entrada (conta em verde), valor e diferença de dias, ações. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/fromAccount" style="@style/Text.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="@color/expense" android:textSize="11sp" />
        <TextView android:id="@+id/fromDescription" style="@style/Text.Muted.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/fromDate" style="@style/Text.Muted.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
    </LinearLayout>
    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:importantForAccessibility="no" android:src="@drawable/ic_arrow_down" app:tint="@color/muted_foreground" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/toAccount" style="@style/Text.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="@color/income" android:textSize="11sp" />
        <TextView android:id="@+id/toDescription" style="@style/Text.Muted.Sm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/toDate" style="@style/Text.Muted.Xs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/border" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/amount" style="@style/Text.Muted.Xs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reject" style="@style/Button.Ghost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="36dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Não é" android:textColor="@color/muted_foreground" app:icon="@drawable/ic_x" app:iconSize="16dp" app:iconTint="@color/muted_foreground" app:iconPadding="4dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/link" style="@style/Button.Outline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="36dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Vincular" app:icon="@drawable/ic_link_2" app:iconSize="16dp" app:iconPadding="4dp" />
    </LinearLayout>
</LinearLayout>
