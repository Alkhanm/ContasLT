<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="96dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/accessIcon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/ic_bell" app:tint="@color/primary" />
                <TextView android:id="@+id/accessTitle" style="@style/Text.Semibold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:id="@+id/accessText" style="@style/Text.Muted.Sm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/accessButton" style="@style/Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/border" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/notifySwitch" style="@style/Text.Sm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Avisar a cada movimento lido, com o botão Confirmar" />
        </LinearLayout>

        <include android:id="@+id/appsTitle" layout="@layout/view_section_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        <LinearLayout android:id="@+id/apps" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp" />

        <include android:id="@+id/testTitle" layout="@layout/view_section_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/testText" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Compra de R$ 45,90 APROVADA em PADARIA X" android:inputType="textMultiLine" android:minLines="2" />
            <TextView android:id="@+id/testResult" style="@style/Text.Sm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/testButton" style="@style/Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ler e mandar para A confirmar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
