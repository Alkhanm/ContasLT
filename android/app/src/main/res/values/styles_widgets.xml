<?xml version="1.0" encoding="utf-8"?>
<!-- Componentes do shadcn-vue usados no PWA, em Views: Input, Button, abas segmentadas. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorHint">@color/muted_foreground</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/primary_foreground</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item><item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="iconTint">@color/foreground</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item><item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item><item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>

    <style name="Button.Destructive" parent="Button.Primary">
        <item name="backgroundTint">@color/destructive</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
