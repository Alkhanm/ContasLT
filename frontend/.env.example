# URL base da API. Vazio = mesma origem (proxy do Vite em dev, ou backend servindo o build).
# Em produção (Firebase Hosting) o valor vem de .env.production; para sobrescrever localmente use .env.local.
VITE_API_URL=
# Login com Google: ID do cliente OAuth "Aplicativo da Web" (Google Cloud › APIs e serviços › Credenciais).
# Não é segredo. Vazio = botão do Google escondido.
VITE_GOOGLE_CLIENT_ID=
